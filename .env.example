# ============== 飞书配置（必填）==============
FEISHU_APP_ID=your_app_id_here
FEISHU_APP_SECRET=your_app_secret_here
FEISHU_BITABLE_TOKEN=your_bitable_token_here
FEISHU_TABLE_ID=your_table_id_here
FEISHU_BOT_WEBHOOK=your_webhook_url_here

# ============== Dify AI 配置 ==============
DIFY_API_URL=http://localhost/v1
DIFY_API_KEY=your_dify_api_key_here
DIFY_APP_ID=your_dify_app_id_here
DIFY_ADMIN_EMAIL=admin@example.com
DIFY_ADMIN_PASSWORD=change_me

# ============== n8n 配置 ==============
N8N_USER=admin
N8N_PASSWORD=change_me
N8N_HOST=localhost
N8N_PUBLISH_URL=http://localhost:5678

# ============== MinIO 配置 ==============
MINIO_USER=minio
MINIO_PASSWORD=change_me

# ============== MiniMax AI 配置 ==============
MINIMAX_API_KEY=your_key_here
MINIMAX_MODEL=MiniMax-M2
MINIMAX_API_URL=https://api.MiniMax.chat/v1

# ============== 公众号（个人订阅号 AppID）==============
WECHAT_APP_ID=wx_your_id_here
WECHAT_APP_SECRET=your_secret_here

# ============== 微博 ==============
WEIBO_ACCESS_TOKEN=your_token_here

# ============== Playwright RPA（多平台 cookie）==============
# 建议通过 xiaohongshu_poster.py 单独登录获取，路径：~/.openclaw/workspace/xiaohongshu_poster.py login

# ============== Timezone ==============
TZ=Asia/Shanghai
