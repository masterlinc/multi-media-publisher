              "value": "={{$json.body.cover_url || ''}}"
            }
          ]
        },
        "options": {}
      },
      "id": "set-vars",
      "name": "提取变量",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [460, 300]
