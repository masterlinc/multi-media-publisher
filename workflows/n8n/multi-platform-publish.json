            {
              "name": "body",
              "value": "={{$json.body.body}}"
            },
            {
              "name": "tags",
              "value": "={{$json.body.tags}}"
            },
            {
              "name": "draft_id",
              "value": "={{$json.body.draft_id}}"
            },
            {
